{% comment %}
  Section: Dein Lebensstil – Left text + Right feature rows
  Usage: Shopify Theme Editor > Add Section > Custom Liquid
{% endcomment %}

<section class="ls-section" id="ls-{{ section.id }}">
  <div class="ls-container">

    {%- comment %} ── Left Column ── {%- endcomment %}
    <div class="ls-left">
      <div class="ls-left__sticky">

        {%- if section.settings.eyebrow != blank -%}
          <span class="ls-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h2 class="ls-title">{{ section.settings.title }}</h2>

        {%- if section.settings.description != blank -%}
          <p class="ls-desc">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.settings.box_text != blank -%}
          <div class="ls-science-box">
            {%- if section.settings.box_label != blank -%}
              <span class="ls-science-box__label">{{ section.settings.box_label }}</span>
            {%- endif -%}
            <p class="ls-science-box__text">{{ section.settings.box_text }}</p>
          </div>
        {%- endif -%}

      </div>
    </div>

    {%- comment %} ── Right Column – Feature Rows ── {%- endcomment %}
    <div class="ls-right">

      {%- for i in (1..6) -%}
        {%- assign title_key  = 'row' | append: i | append: '_title' -%}
        {%- assign text_key   = 'row' | append: i | append: '_text' -%}
        {%- assign badge_key  = 'row' | append: i | append: '_badge' -%}
        {%- assign icon_key   = 'row' | append: i | append: '_icon' -%}
        {%- assign iconbg_key = 'row' | append: i | append: '_iconbg' -%}
        {%- assign iconco_key = 'row' | append: i | append: '_iconcolor' -%}

        {%- if section.settings[title_key] != blank -%}
          <div class="ls-row">

            {%- comment %} Icon {%- endcomment %}
            <span class="ls-row__icon" style="background:{{ section.settings[iconbg_key] }};color:{{ section.settings[iconco_key] }};">
              {%- case section.settings[icon_key] -%}
                {%- when 'moon' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                {%- when 'fork' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="8" x2="18" y2="21"/><line x1="6" y1="8" x2="6" y2="21"/><path d="M6 3v5a3 3 0 0 0 6 0V3"/><path d="M15 3v5a3 3 0 0 0 6 0V3"/></svg>
                {%- when 'activity' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                {%- when 'heart' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- when 'star' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- when 'sparkle' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M3 12h3M18 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
                {%- when 'sun' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                {%- when 'leaf' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8C8 10 5.9 16.17 3.82 22L5 21.5c.83-.33 1.67-.5 2.5-.5C12 21 16 17 17 8z"/></svg>
                {%- when 'droplet' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                {%- when 'wind' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
                {%- else -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              {%- endcase -%}
            </span>

            {%- comment %} Content {%- endcomment %}
            <div class="ls-row__content">
              <div class="ls-row__top">
                <strong class="ls-row__title">{{ section.settings[title_key] }}</strong>
                {%- if section.settings[badge_key] != blank -%}
                  <span class="ls-row__badge">{{ section.settings[badge_key] }}</span>
                {%- endif -%}
              </div>
              <p class="ls-row__text">{{ section.settings[text_key] }}</p>
            </div>

          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

  </div>
</section>
<script>
(function () {
  var section = document.getElementById('ls-{{ section.id }}');
  if (!section) return;

  var targets = section.querySelectorAll(
    '.ls-left, .ls-row'
  );

  targets.forEach(function (el) {
    el.classList.add('ls-fade-up');
  });

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  targets.forEach(function (el) {
    observer.observe(el);
  });
})();
</script>

<style>
  #ls-{{ section.id }} {
    --ls-bg:            {{ section.settings.section_bg }};
    --ls-eyebrow:       {{ section.settings.eyebrow_color }};
    --ls-title:         {{ section.settings.title_color }};
    --ls-desc:          {{ section.settings.desc_color }};
    --ls-box-bg:        {{ section.settings.box_bg }};
    --ls-box-border:    {{ section.settings.box_border }};
    --ls-box-label:     {{ section.settings.box_label_color }};
    --ls-box-text:      {{ section.settings.box_text_color }};
    --ls-row-bg:        {{ section.settings.row_bg }};
    --ls-row-border:    {{ section.settings.row_border }};
    --ls-row-title:     {{ section.settings.row_title_color }};
    --ls-row-text:      {{ section.settings.row_text_color }};
    --ls-badge-bg:      {{ section.settings.badge_bg }};
    --ls-badge-color:   {{ section.settings.badge_color }};
  }

  /* ── Section ── */
  .ls-section {
    background: var(--ls-bg);
    padding: 80px 40px;
  }
  .ls-container {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 64px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .ls-section { padding: 60px 20px; }
    .ls-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* ── Left Column ── */
  .ls-left__sticky {
    position: sticky;
    top: 40px;
  }
  .ls-eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ls-eyebrow);
    margin-bottom: 18px;
  }
  .ls-title {
    font-size: clamp(36px, 3vw, 48px);
    font-weight: 400;
    color: var(--ls-title);
    line-height: 1.18;
    margin: 0 0 24px;
  }
  .ls-desc {
    font-size: 16px;
    line-height: 1.75;
    color: var(--ls-desc);
    margin: 0 0 28px;
  }

  /* Science box */
  .ls-science-box {
    background: var(--ls-box-bg);
    border: 1px solid var(--ls-box-border);
    border-radius: 12px;
    padding: 20px 22px;
  }
  .ls-science-box__label {
    display: block;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ls-box-label);
    margin-bottom: 12px;
  }
  .ls-science-box__text {
    font-size: 13px;
    line-height: 1.7;
    color: var(--ls-box-text);
    margin: 0;
  }

  /* ── Right Column – Rows ── */
  .ls-right {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Single row card */
  .ls-row {
    background: var(--ls-row-bg);
    border: 1px solid var(--ls-row-border);
    border-radius: 14px;
    padding: 20px 22px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }

  /* Icon box */
  .ls-row__icon {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Content */
  .ls-row__content {
    flex: 1;
    min-width: 0;
  }
  .ls-row__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .ls-row__title {
    font-size: 14px;
    font-weight: 700;
    color: var(--ls-row-title);
    line-height: 1.2;
  }
  .ls-row__badge {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ls-badge-color);
    background: var(--ls-badge-bg);
    padding: 4px 10px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .ls-row__text {
    font-size: 12px;
    line-height: 1.65;
    color: var(--ls-row-text);
    margin: 0;
  }
  /* ── Row Card Hover Effects ── */
  .ls-row {
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
                box-shadow 0.35s cubic-bezier(0.22, 0.61, 0.36, 1),
                border-color 0.35s ease;
    cursor: default;
  }

  .ls-row:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
    border-color: #d0cbc4;
  }

  /* Icon bounce on row hover */
  .ls-row:hover .ls-row__icon svg {
    animation: ls-icon-bounce 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  @keyframes ls-icon-bounce {
    0%   { transform: scale(1) rotate(0deg); }
    40%  { transform: scale(1.2) rotate(-10deg); }
    70%  { transform: scale(0.95) rotate(6deg); }
    100% { transform: scale(1) rotate(0deg); }
  }

  /* ── Fade-Up Animation ── */
  .ls-fade-up {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .ls-fade-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Left column stagger */
  .ls-left.ls-fade-up       { transition-delay: 0s; }

  /* Right rows stagger */
  .ls-row.ls-fade-up:nth-child(1) { transition-delay: 0.05s; }
  .ls-row.ls-fade-up:nth-child(2) { transition-delay: 0.13s; }
  .ls-row.ls-fade-up:nth-child(3) { transition-delay: 0.21s; }
  .ls-row.ls-fade-up:nth-child(4) { transition-delay: 0.29s; }
  .ls-row.ls-fade-up:nth-child(5) { transition-delay: 0.37s; }
  .ls-row.ls-fade-up:nth-child(6) { transition-delay: 0.45s; }
</style>

