{% comment %}
  Section: Wichtige Hinweise — Important Notes, Limits & Privacy
  Accordion-style FAQ with smooth animations, fully editable via theme editor
{% endcomment %}

<style>
  .wh-section {
    background-color: {{ section.settings.section_bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .wh-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 80px;
  }

  /* ── Header ── */
  .wh-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .wh-eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 16px;
    display: block;
  }

  .wh-headline {
    font-size: clamp(36px, 4vw, 48px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: {{ section.settings.headline_color }};
    margin: 0 0 20px;
  }

  .wh-subtext {
    font-size: 16px;
    line-height: 1.7;
    color: {{ section.settings.subtext_color }};
    max-width: 580px;
    margin: 0 auto;
  }

  /* ── Accordion list ── */
  .wh-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }

  /* ── Accordion item ── */
  .wh-item {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 14px;
    overflow: hidden;
    transition: box-shadow 0.25s ease;
  }

  .wh-item.is-open {
    box-shadow: 0 4px 24px rgba(0,0,0,0.07);
  }

  /* ── Trigger button ── */
  .wh-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    -webkit-tap-highlight-color: transparent;
  }

  .wh-trigger:focus-visible {
    outline: 2px solid {{ section.settings.eyebrow_color }};
    outline-offset: -2px;
    border-radius: 14px;
  }

  /* ── Icon pill ── */
  .wh-icon-wrap {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: {{ section.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .wh-item.is-open .wh-icon-wrap {
    background: {{ section.settings.icon_bg_open_color }};
  }

  .wh-icon-wrap svg {
    width: 18px;
    height: 18px;
    stroke: {{ section.settings.icon_color }};
    fill: none;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .wh-item.is-open .wh-icon-wrap svg {
    stroke: {{ section.settings.icon_open_color }};
  }

  /* ── Title & tag ── */
  .wh-trigger-inner {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }

  .wh-item-title {
    font-size: 14px;
    font-weight: 700;
    color: {{ section.settings.item_title_color }};
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .wh-trigger-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .wh-tag {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ section.settings.tag_color }};
    white-space: nowrap;
  }

  .wh-chevron {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wh-chevron svg {
    width: 100%;
    height: 100%;
    stroke: {{ section.settings.chevron_color }};
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wh-item.is-open .wh-chevron {
    transform: rotate(180deg);
  }

  /* ── Panel (accordion body) ── */
  .wh-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.36s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wh-item.is-open .wh-panel {
    grid-template-rows: 1fr;
  }

  .wh-panel-inner {
    overflow: hidden;
  }

  .wh-panel-content {
    padding: 0 24px 24px 80px;
    opacity: 0;
    margin-top: 12px;
    transform: translateY(-6px);
    transition:
      opacity 0.28s ease 0.04s,
      transform 0.32s cubic-bezier(0.4, 0, 0.2, 1) 0.04s;
  }

  .wh-item.is-open .wh-panel-content {
    opacity: 1;
    transform: translateY(0);
  }

  .wh-panel-text {
    font-size: 12px;
    line-height: 1.7;
    color: {{ section.settings.panel_text_color }};
    margin: 0 0 16px;
  }

  .wh-legal-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ section.settings.legal_badge_color }};
    border-left: 2px solid {{ section.settings.legal_badge_color }};
    padding-left: 10px;
    margin-top: 4px;
  }

  /* ── Divider between trigger and panel ── */
  .wh-divider {
    height: 1px;
    background: {{ section.settings.card_border_color }};
    margin: 0 24px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s ease;
  }

  .wh-item.is-open .wh-divider {
    transform: scaleX(1);
  }

  /* ── Privacy note card ── */
  .wh-privacy-card {
    background: {{ section.settings.privacy_card_bg }};
    border: 1px solid {{ section.settings.privacy_card_border }};
    border-radius: 14px;
    padding: 20px 28px;
    text-align: center;
    margin-top: 12px;
  }

  .wh-privacy-text {
    font-size: 12px;
    line-height: 1.65;
    color: {{ section.settings.privacy_text_color }};
    margin: 0;
  }

  .wh-privacy-text strong {
    font-weight: 700;
    color: {{ section.settings.privacy_bold_color }};
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .wh-container { padding: 0 20px; }
    .wh-tag { display: none; }
    .wh-panel-content { padding-left: 56px; }
    .wh-item-title { font-size: 15px; }
  }
  /* ── Fade-Up Animation ── */
  .wh-fade-up {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .wh-fade-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .wh-header.wh-fade-up        { transition-delay: 0s; }
  .wh-item.wh-fade-up:nth-child(1) { transition-delay: 0.08s; }
  .wh-item.wh-fade-up:nth-child(2) { transition-delay: 0.16s; }
  .wh-item.wh-fade-up:nth-child(3) { transition-delay: 0.24s; }
  .wh-item.wh-fade-up:nth-child(4) { transition-delay: 0.32s; }
  .wh-item.wh-fade-up:nth-child(5) { transition-delay: 0.40s; }
  .wh-item.wh-fade-up:nth-child(6) { transition-delay: 0.48s; }
  .wh-privacy-card.wh-fade-up  { transition-delay: 0.56s; }
</style>

<section class="wh-section" id="section-{{ section.id }}">
  <div class="wh-container">

    <!-- Header -->
    <div class="wh-header">
      {% if section.settings.eyebrow != blank %}
        <span class="wh-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="wh-headline">{{ section.settings.headline }}</h2>
      {% if section.settings.subtext != blank %}
        <p class="wh-subtext">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    <!-- Accordion -->
    <div class="wh-accordion-list" role="list">
      {% assign first_open = true %}
      {% for block in section.blocks %}
        {% if block.type == 'accordion_item' %}
          {% assign is_open = false %}
          {% if first_open and section.settings.first_open %}
            {% assign is_open = true %}
            {% assign first_open = false %}
          {% endif %}
          <div
            class="wh-item{% if is_open %} is-open{% endif %}"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            <button
              class="wh-trigger"
              aria-expanded="{{ is_open }}"
              aria-controls="wh-panel-{{ block.id }}"
              id="wh-trigger-{{ block.id }}"
            >
              <div class="wh-icon-wrap" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'shield' %}
                    <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {% when 'stethoscope' %}
                    <svg viewBox="0 0 24 24"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
                  {% when 'lock' %}
                    <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {% when 'user' %}
                    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  {% when 'info' %}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                  {% when 'check' %}
                    <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v4m0 4h.01"/></svg>
                {% endcase %}
              </div>
              <div class="wh-trigger-inner">
                <h3 class="wh-item-title">{{ block.settings.title }}</h3>
                <div class="wh-trigger-right">
                  {% if block.settings.tag != blank %}
                    <span class="wh-tag">{{ block.settings.tag }}</span>
                  {% endif %}
                  <span class="wh-chevron" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </div>
              </div>
            </button>

            <div class="wh-divider" aria-hidden="true"></div>

            <div
              class="wh-panel"
              id="wh-panel-{{ block.id }}"
              role="region"
              aria-labelledby="wh-trigger-{{ block.id }}"
            >
              <div class="wh-panel-inner">
                <div class="wh-panel-content">
                  {% if block.settings.content != blank %}
                    <p class="wh-panel-text">{{ block.settings.content }}</p>
                  {% endif %}
                  {% if block.settings.legal_badge != blank %}
                    <span class="wh-legal-badge">{{ block.settings.legal_badge }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Privacy note -->
    {% if section.settings.privacy_note != blank %}
      <div class="wh-privacy-card">
        <p class="wh-privacy-text">{{ section.settings.privacy_note }}</p>
      </div>
    {% endif %}

  </div>
</section>

<script>
(function() {
  var section = document.getElementById('section-{{ section.id }}');
  if (!section) return;

  // ── Accordion logic (same as before) ──
  section.querySelectorAll('.wh-trigger').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = btn.closest('.wh-item');
      var isOpen = item.classList.contains('is-open');

      section.querySelectorAll('.wh-item.is-open').forEach(function(el) {
        if (el !== item) {
          el.classList.remove('is-open');
          el.querySelector('.wh-trigger').setAttribute('aria-expanded', 'false');
        }
      });

      if (!isOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      } else {
        item.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // ── Fade-up animation ──
  var targets = section.querySelectorAll(
    '.wh-header, .wh-item, .wh-privacy-card'
  );

  targets.forEach(function(el) {
    el.classList.add('wh-fade-up');
  });

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  targets.forEach(function(el) {
    observer.observe(el);
  });
})();
</script>

